{
  "name": "members-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "supabase start -x vector,logflare,edge-runtime,imgproxy,supavisor,realtime",
    "db:stop": "supabase stop",
    "test": "npm run test:hooks && npm run test:e2e && npm run test:rls",
    "test:hooks": "node --test tests/hooks.test.mjs",
    "test:e2e": "node scripts/build-demo.mjs && node --test tests/demo.e2e.test.mjs",
    "test:rls": "supabase db reset && node tests/rls.test.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4",
    "puppeteer-core": "22.15.0"
  }
}
